{
  "agent": {
    "model": "kimi-k3-low"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.config/devin/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.config/devin/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.config/devin/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.config/devin/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.config/devin/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.config/devin/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "shell": {
    "setup_complete": true
  },
  "theme_mode": "terminal-dark",
  "version": 1
}
