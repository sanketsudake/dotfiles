# Machine-local overrides — copy to ~/.config/zsh/90-local.zsh on this machine
# only (a plain untracked file; home-manager leaves it alone).
# Put anything here that must not be committed: secrets, work-specific exports,
# host-specific paths.
#
# cp ~/.config/zsh/90-local.zsh.example ~/.config/zsh/90-local.zsh
#
# export MY_TOKEN=...
